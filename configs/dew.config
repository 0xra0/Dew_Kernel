# Device-specific config for POCO C85 5G (dew) — GKI 6.6
# Derived from stock /proc/config.gz vs gki_defconfig diff.
# gki_defconfig is intentionally minimal; these fill the gaps for correct device operation.

# ── Power management ──────────────────────────────────────────────────────────
# Required for suspend/resume (sleep button, doze). Missing = no sleep at all.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y

# ── CPU frequency / scheduler ─────────────────────────────────────────────────
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_ISOLATION=y

# ── I/O schedulers ────────────────────────────────────────────────────────────
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y

# ── EROFS filesystem ──────────────────────────────────────────────────────────
# /system and /vendor are EROFS images. XATTR + SECURITY are required for
# SELinux to read security labels from those partitions — missing = SELinux blind.
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y

# ── F2FS filesystem ───────────────────────────────────────────────────────────
# /data is F2FS with inline compression. Stock uses all four algorithms.
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZORLE=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_IOSTAT=y

# ── Security hardening ────────────────────────────────────────────────────────
CONFIG_STACKPROTECTOR_STRONG=y

# ── TCP BBR congestion control ────────────────────────────────────────────────
# BBR v2 significantly improves throughput on lossy networks (mobile LTE/5G).
# FQ qdisc is required as the pacing scheduler for BBR.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
# Disable legacy algorithms to reduce image size and avoid user confusion
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set

# ── TMPFS extended attributes ─────────────────────────────────────────────────
# Required for proper SELinux labelling on /dev, /tmp, and shared-memory mounts.
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# ── TTL / Hop-Limit netfilter targets ─────────────────────────────────────────
# Allows apps to manipulate IPv4 TTL and IPv6 HL via iptables/ip6tables.
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_IP6_NF_MATCH_HL=y
