# SUSFS4KSU config options for SukiSU Ultra
# Applied on top of gki_defconfig during build
# Ref: https://gitlab.com/simonpunk/susfs4ksu

# Core SUSFS support (required)
CONFIG_KSU_SUSFS=y

# SUS_PATH is disabled for kernel 6.6 — the VFS hook model in 6.6 makes
# per-path hiding unnecessary and the feature causes build issues on GKI 6.6.
# CONFIG_KSU_SUSFS_SUS_PATH is not set

# Mount hiding — hide specific mount points
CONFIG_KSU_SUSFS_SUS_MOUNT=y

# Virtual memory map hiding
CONFIG_KSU_SUSFS_SUS_MAP=y

# Stat spoofing — spoof inode/stat for hidden files
CONFIG_KSU_SUSFS_SUS_KSTAT=y

# OverlayFS hiding — hide overlayfs mounts used by modules
CONFIG_KSU_SUSFS_SUS_OVERLAYFS=y

# Auto-add default KSU/SUS mounts to sus_mount list
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y

# Auto-add bind mounts to sus_mount list
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y

# Try-umount — automatically unmount sus mounts on process exit
CONFIG_KSU_SUSFS_TRY_UMOUNT=y

# Auto-add bind mounts to try_umount list
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y

# Hide KSU/SUSFS kernel symbols from /proc/kallsyms
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y

# Uname spoofing — hide custom kernel string from uname()
CONFIG_KSU_SUSFS_SPOOF_UNAME=y

# Spoof /proc/cmdline or bootconfig to hide KSU presence
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y

# SUSFS log output (disable in production for stealth)
CONFIG_KSU_SUSFS_ENABLE_LOG=y

# Open redirect — redirect open() calls for hidden paths
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y

# SuS SU — SukiSU Ultra's root shell access companion
CONFIG_KSU_SUSFS_SUS_SU=y
